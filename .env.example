# ============================================
# FB Dracin - Configuration
# ============================================

# --- OpenRouter (AI) ---
OPENROUTER_API_KEY=sk-or-v1-xxxx...your_openrouter_key
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Facebook Page ---
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=EAAx...your_long_lived_page_token...

# --- Posting ---
POST_INTERVAL_HOURS=4
MAX_POSTS_PER_RUN=3

# --- Sources ---
NEWS_SOURCE_URL=https://mydramalist.com/shows/popular

# --- Image ---
LOGO_PATH=./assets/logo.png
IMAGE_WIDTH=800
IMAGE_HEIGHT=1200
# Style: dracin, viral, modern, breaking, magazine, cinematic
IMAGE_STYLE=dracin
