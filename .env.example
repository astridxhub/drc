# ============================================
# FB Dracin - Configuration
# ============================================

# --- AI Provider: Groq (primary) ---
GROQ_API_KEY=gsk_xxxx...your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenRouter (fallback) ---
OPENROUTER_API_KEY=sk-or-v1-xxxx...your_openrouter_key

# --- Facebook Page ---
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=EAAx...your_long_lived_page_token...

# --- Posting ---
POST_INTERVAL_HOURS=4
MAX_POSTS_PER_RUN=40

# --- Sources (comma-separated) ---
NEWS_SOURCE_URLS=https://mydramalist.com/shows/popular,https://mydramalist.com/shows/upcoming,https://www.iq.com/newOnline?lang=id_id,https://wetv.vip/id/channel/10054?id=10054&type=PAGE_TYPE_MODULE_LIST

# --- Image ---
LOGO_PATH=./assets/logo.png
IMAGE_WIDTH=800
IMAGE_HEIGHT=1200
# Style: dracin, viral, modern, breaking, magazine, cinematic
IMAGE_STYLE=dracin
